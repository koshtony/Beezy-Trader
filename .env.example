# Production variables (Railway: service -> Variables -> Raw Editor accepts this format).

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Railway's generated domain is trusted automatically; list custom domains here (comma-separated).
DJANGO_ALLOWED_HOSTS=
# e.g. https://markets.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Already set by the Docker image (shown for other hosts):
# DJANGO_DEBUG=0
# BEEZY_DATA_DIR=/data
# BEEZY_SCHEDULER=1

# Load ~10 years of history automatically into an empty database (about 75 minutes).
BEEZY_AUTO_BOOTSTRAP=1
# Only while deliberately replacing production data with an uploaded seed.sqlite3; remove afterwards.
# BEEZY_ALLOW_SEED=1

# Optional: lets scripts call POST /api/jobs/refresh with an X-API-Key header.
BEEZY_API_KEY=
# Optional: 1 keeps the interactive API docs at /api/docs in production.
BEEZY_API_DOCS=0
# Optional tuning: gunicorn processes (each ~100-200 MB) and threads; 1 logs every request.
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
GUNICORN_ACCESS_LOG=0
